{
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "keywords": [
    "bump",
    "bump.ts",
    "bump-ts",
    "collision detection",
    "gamedev",
    "arcade",
    "collisions"
  ],
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsc -p tsconfig.build.json --module commonjs --outDir dist --watch",
    "build": "tsc -p tsconfig.build.json --module commonjs --outDir dist && tsc -p tsconfig.build.json --module esnext --declaration false --outDir dist/esm",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "benchmark": "ts-node -T --project benchmarks/tsconfig.json benchmarks/update.bench.js",
    "benchmark:track": "pnpm benchmark > benchmarks/benchmarks.md"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm lint"
    }
  },
  "name": "bump-ts",
  "author": "Andrea Cappuccio <hood@null.net>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hood/bump.ts.git"
  },
  "module": "dist/esm/index.js",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/esm/index.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/benchmark": "^2.1.5",
    "benchmark": "^2.1.4",
    "husky": "^7.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "size-limit": "^13.0.3",
    "ts-node": "^10.9.2",
    "tsdx": "^2.0.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
