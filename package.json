{
  "version": "0.6.3",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "keywords": [
    "bump",
    "bump.ts",
    "bump-ts",
    "collision detection",
    "gamedev",
    "arcade",
    "collisions"
  ],
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsc -p tsconfig.build.json --module commonjs --outDir dist --watch",
    "build": "tsc -p tsconfig.build.json --module commonjs --outDir dist && tsc -p tsconfig.build.json --module esnext --declaration false --outDir dist/esm",
    "test": "tsdx test",
    "lint": "tsdx lint",
    "prepare": "pnpm build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "benchmark": "ts-node -T --project benchmarks/tsconfig.json benchmarks/update.bench.js",
    "benchmark:track": "pnpm benchmark > benchmarks/benchmarks.md"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "bump-ts",
  "author": "Andrea Cappuccio <hood@null.net>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hood/bump.ts.git"
  },
  "module": "dist/esm/index.js",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/esm/index.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^5.0.1",
    "@types/benchmark": "^2.1.5",
    "benchmark": "^2.1.4",
    "husky": "^7.0.1",
    "size-limit": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsdx": "^0.14.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
