{
  // Emit config used by `pnpm build`. The root tsconfig is type-check only
  // (noEmit), so the build overrides just what it needs to produce `dist`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Target comes from the root tsconfig (es2022, matching the Node >=24
    // engines floor). es2022 output needs no downlevel helpers, so tslib stays
    // a dev-only dep.
    "importHelpers": false,
    "outDir": "./dist"
  }
}
